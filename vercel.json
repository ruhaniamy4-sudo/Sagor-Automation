{
  "services": {
    "sagor-automation": {
      "root": ".",
      "entrypoint": "app.py",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "sagor-automation"
      }
    }
  ]
}
